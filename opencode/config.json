{
  "$schema": "https://opencode.ai/config.json",
  "model": "tensorix/z-ai/glm-5.2",
  "formatter": {
    "alejandra": {
      "command": ["alejandra", "$FILE"],
      "extensions": [".nix"]
    }
  },
  "provider": {
    "tensorix": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Tensorix",
      "options": {
        "baseURL": "https://api.tensorix.ai/v1",
        "apiKey": "{env:TENSORIX_API_KEY}"
      },
      "models": {
        "qwen/qwen3-235b-a22b-2507": { "name": "Qwen3 235B A22B 2507" },
        "qwen/qwen3-coder-30b-a3b-instruct": { "name": "Qwen3 Coder 30B A3B Instruct" },
        "qwen/qwen3-vl-235b-a22b-instruct": { "name": "Qwen3-VL 235B A22B Instruct" },
        "qwen/qwen3.5-9b": { "name": "Qwen3.5 9B" },
        "qwen/qwen3.5-122b-a10b": { "name": "Qwen3.5 122B A10B" },
        "deepseek/deepseek-r1-0528": { "name": "DeepSeek R1 0528" },
        "deepseek/deepseek-chat-v3.1": { "name": "DeepSeek Chat v3.1" },
        "deepseek/deepseek-v3.2": { "name": "DeepSeek v3.2" },
        "deepseek/deepseek-v4-flash": { "name": "DeepSeek v4 Flash" },
        "deepseek/deepseek-v4-pro": { "name": "DeepSeek v4 Pro" },
        "minimax/minimax-m2.5": { "name": "MiniMax M2.5" },
        "minimax/minimax-m3": { "name": "MiniMax M3" },
        "moonshotai/kimi-k2.5": { "name": "Kimi K2.5" },
        "moonshotai/kimi-k2.6": { "name": "Kimi K2.6" },
