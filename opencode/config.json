        "z-ai/glm-4.7": { "name": "GLM 4.7" },
        "z-ai/glm-5": { "name": "GLM 5" },
        "z-ai/glm-5.1": { "name": "GLM 5.1" },
        "z-ai/glm-5.2": { "name": "GLM 5.2" },
        "z-ai/glm-5-turbo": { "name": "GLM 5 Turbo" },
